BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwXYZ

# PostgreSQL Settings
POSTGRES_USER=schedule_user
POSTGRES_PASSWORD=secret_password
POSTGRES_DB=schedule_db
# Если запускаешь через Docker, хост должен быть 'db' (имя сервиса в docker-compose)
# Если запускаешь локально без докера, ставь 'localhost'
POSTGRES_HOST=db
POSTGRES_PORT=5432